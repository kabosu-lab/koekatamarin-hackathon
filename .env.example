# コピーして .env を作り、gmail の Claude Console で作った API キーを入れる（.env は公開しない）
ANTHROPIC_API_KEY=

# 本物の Teams。data/teams.json とサインインがあれば送る。off で止める。webhook で Workflow を使う（予備）
# KOEKATA_TEAMS=off
# KOEKATA_TEAMS_WEBHOOK_URL=

# 撮影と審査用。時間外（土日と平日 19 時以降など）でも返事の知らせを出す
# KOEKATA_NOTICE_ALWAYS=1
# Teams からの取り込みの間隔（ミリ秒）。既定は 30000。撮影のときだけ短くする
# KOEKATA_TEAMS_SYNC_MS=5000
