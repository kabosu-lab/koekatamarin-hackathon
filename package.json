{
  "name": "koekata",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "try:voice": "tsx --env-file-if-exists=.env scripts/try-voice.ts",
    "dev:phone": "next dev --experimental-https --hostname 0.0.0.0",
    "try:compose": "tsx --env-file-if-exists=.env scripts/try-compose.ts",
    "try:safety": "tsx --env-file-if-exists=.env scripts/try-safety.ts",
    "try:knowledge": "tsx --env-file-if-exists=.env scripts/try-knowledge.ts",
    "try:connect": "tsx --env-file-if-exists=.env scripts/try-connect.ts",
    "try:reply": "tsx --env-file-if-exists=.env scripts/try-reply.ts",
    "db:reset": "rm -f data/koekata.db data/koekata.db-wal data/koekata.db-shm",
    "try:cheer": "tsx --env-file-if-exists=.env scripts/try-cheer.ts",
    "try:profile": "tsx --env-file-if-exists=.env scripts/try-profile.ts",
    "try:daily": "tsx --env-file-if-exists=.env scripts/try-daily.ts",
    "setup:evening": "tsx --env-file-if-exists=.env scripts/setup-evening-agent.ts",
    "try:evening": "tsx --env-file-if-exists=.env scripts/try-evening.ts",
    "try:lookback": "tsx --env-file-if-exists=.env scripts/try-lookback.ts",
    "try:attachment": "tsx --env-file-if-exists=.env scripts/try-attachment.ts",
    "try:avatar": "tsx --env-file-if-exists=.env scripts/try-avatar.ts",
    "feedback:list": "tsx scripts/feedback-list.ts",
    "try:goal": "tsx --env-file-if-exists=.env scripts/try-goal.ts",
    "try:walk": "tsx --env-file-if-exists=.env scripts/try-walk.ts",
    "try:title": "tsx --env-file-if-exists=.env scripts/try-title.ts",
    "try:gift-egg": "tsx --env-file-if-exists=.env scripts/try-gift-egg.ts",
    "demo:attachments": "tsx scripts/make-demo-attachments.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
